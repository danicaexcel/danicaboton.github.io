{
  "name": "Project 02 - 01 Task Integrity & Project Sync",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "portfolio-project02-task-integrity",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "task-integrity-webhook",
      "name": "Family Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-720, 0]
    },
    {
      "parameters": {
        "jsCode": "const raw=$json.body??$json;\nconst allowed=[\"task.validate\", \"task.sync\", \"project.sync\", \"task.complete\", \"task.sendReview\", \"task.approve\"];\nif(!raw.action||!allowed.includes(raw.action)) throw new Error(`Unsupported action for this workflow: ${raw.action||'missing'}`);\nconst actionMap={};\nconst originalAction=raw.action;\nconst action=actionMap[originalAction]||originalAction;\nreturn [{json:{\n  ...raw,\n  originalAction,\n  action,\n  project:raw.project||'monday-project-ops',\n  clientId:raw.clientId||raw.payload?.clientId||'default-demo',\n  requestId:raw.requestId||String($execution.id),\n  correlationId:raw.correlationId||raw.requestId||String($execution.id),\n  payload:raw.payload||{},\n  workflowFamily:\"Project 02 - 01 Task Integrity & Project Sync\"\n}}];"
      },
      "id": "task-integrity-normalize",
      "name": "Normalize Family Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-500, 0]
    },
    {
      "parameters": {
        "jsCode": "const p=$json.payload||{}; const a=$json.action;\nif(a==='project.sync' && !p.projectId) throw new Error('projectId is required');\nif(a!=='project.sync' && !(p.itemId||p.taskId)) throw new Error('itemId or taskId is required');\nreturn [{json:$json}];"
      },
      "id": "task-integrity-validate",
      "name": "Validate Family Rules",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-280, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5678/webhook/portfolio-enterprise-operations",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "task-integrity-core",
      "name": "Call Core State Engine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-40, 0]
    },
    {
      "parameters": {
        "jsCode": "const r=$json;\nreturn [{json:{...r,workflowFamily:$node[\"Normalize Family Request\"].json.workflowFamily,originalAction:$node[\"Normalize Family Request\"].json.originalAction,familyExecutionId:$execution.id}}];"
      },
      "id": "task-integrity-annotate",
      "name": "Annotate Family Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [200, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {"responseCode": 200}
      },
      "id": "task-integrity-respond",
